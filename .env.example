# Environment variables example file
# Copy this file to .env and update with your actual values

# API Configuration
API_HOST=0.0.0.0
API_PORT=15372
API_DEBUG=false
# 可选：设置后全端点要求 `Authorization: Bearer <token>`；留空则不鉴权（默认）
API_AUTH_TOKEN=
# 可选：CORS 允许来源白名单，逗号分隔；默认 *（不限制）
API_CORS_ORIGINS=*

# GUI Configuration
GUI_TITLE=Publish Helper
GUI_VERSION=1.4.5

# PT-Gen API Configuration
PTGEN_API_URL=
PTGEN_API_KEY=

# Image Hosting Configuration
IMAGE_HOST_TYPE=freeimage
IMAGE_HOST_API_URL=
IMAGE_HOST_API_KEY=

# Media Info Configuration
MEDIAINFO_PATH=

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Temp directories
TEMP_DIR=temp
MEDIA_DIR=media
STATIC_DIR=static
